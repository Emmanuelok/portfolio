# Optional: AI SDK Gateway authentication for Kingxford Agent.
# Vercel deployments can use the platform-provided OIDC token instead.
AI_GATEWAY_API_KEY=

# Optional stable HMAC salt for privacy-preserving anonymous review quotas.
# Generate this as a high-entropy server-only secret; never expose it publicly.
KINGXFORD_CLIENT_HASH_SECRET=

# Frontier model and versioned creative-agent protocol.
KINGXFORD_CREATIVE_MODEL=openai/gpt-5.6-sol
# Keep fallbacks within the current GPT-5.6 family. The deterministic local
# review remains the final fallback when configured providers are unavailable.
KINGXFORD_CREATIVE_FALLBACK_MODELS=openai/gpt-5.6-terra

# Governed multi-pass project-intelligence runtime. Standard runs use medium
# reasoning effort; Deep runs use documented max effort in standard mode.
KINGXFORD_INTELLIGENCE_MODEL=openai/gpt-5.6-sol
KINGXFORD_INTELLIGENCE_FALLBACK_MODEL=openai/gpt-5.6-terra

# Keep empty until the separate entrepreneurship platform has a real URL.
NEXT_PUBLIC_AI_ENTREPRENEURSHIP_URL=

# Optional public contact address. When configured, Contact opens an addressed,
# user-reviewed email draft; the platform never sends the message silently.
NEXT_PUBLIC_CONTACT_EMAIL=
