# Public URLs. Keep these canonical and omit trailing slashes.
NEXT_PUBLIC_SITE_URL=https://kingxford.co
NEXT_PUBLIC_AI_ENTREPRENEURSHIP_URL=

# Optional local/third-party AI Gateway authentication.
# Vercel deployments should use the automatically supplied OIDC identity instead.
# Never expose this value through a NEXT_PUBLIC_* variable or commit a real key.
AI_GATEWAY_API_KEY=

# Versioned Kingxford model routes. Each fallback list accepts at most two
# comma-separated Vercel AI Gateway provider/model slugs.
KINGXFORD_CREATIVE_STANDARD_MODEL=openai/gpt-5.6-terra
KINGXFORD_CREATIVE_STANDARD_FALLBACK_MODELS=openai/gpt-5.6-luna,openai/gpt-5.4-mini
KINGXFORD_CREATIVE_DEEP_MODEL=openai/gpt-5.6-sol
KINGXFORD_CREATIVE_DEEP_FALLBACK_MODELS=openai/gpt-5.6-terra,openai/gpt-5.4

# Public-review safeguards. These are process-local controls, not durable
# account entitlements; use external identity, Redis, and billing before launch
# of authenticated plans.
KINGXFORD_AGENT_REQUESTS_PER_MINUTE=6
KINGXFORD_AGENT_DAILY_CREDITS=30
KINGXFORD_AGENT_MAX_CONCURRENT=2

# Optional secret used only to strengthen pseudonymous usage-bucket hashes.
# Generate a high-entropy server-only value for production. Rotating it resets
# process-local anonymous buckets; it does not alter user content.
KINGXFORD_USAGE_HASH_SALT=
