# Canonical public configuration. Omit trailing slashes.
NEXT_PUBLIC_SITE_URL=https://kingxford.co
NEXT_PUBLIC_CONTACT_EMAIL=projects@kingxford.co

# Supabase browser configuration. These two values are intentionally public;
# authorization is enforced by Row Level Security, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the anon-key name instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server administration. SUPABASE_URL is optional when the public URL
# above points at the same project. The service-role key is server-only and is
# used by authenticated routes for private evidence-object I/O and account
# cleanup, and by durable workflow steps for final run/audit records.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Durable distributed AI usage protection. Provision one Upstash Redis store
# and set both values in Preview and Production. Vercel KV aliases are accepted
# by the application, but these canonical names keep the deployment portable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# This test hatch permits process-memory limits only on a non-Vercel runtime.
# Leave it disabled in shared environments; VERCEL=1 always ignores it.
KINGXFORD_ALLOW_EPHEMERAL_USAGE=0

# Separate local-only fallback for project-enquiry abuse protection. It is
# ignored when VERCEL=1 or NODE_ENV=production. Production and Preview must use
# the Upstash values above; contact counters never consume AI usage credits.
KINGXFORD_ALLOW_EPHEMERAL_CONTACT=0

# Secure project-enquiry delivery through Resend. CONTACT_FROM_EMAIL must use a
# verified sending domain; CONTACT_INBOX_EMAIL is the private receiving inbox.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=enquiries@kingxford.co
CONTACT_INBOX_EMAIL=projects@kingxford.co

# Optional local or non-Vercel AI Gateway authentication. Vercel deployments
# should use the automatically supplied OIDC identity. Never expose this key
# through a NEXT_PUBLIC_* variable or commit a real value.
AI_GATEWAY_API_KEY=

# Versioned Kingxford model routes. Each fallback list accepts at most two
# comma-separated Vercel AI Gateway provider/model slugs.
KINGXFORD_CREATIVE_STANDARD_MODEL=openai/gpt-5.6-terra
KINGXFORD_CREATIVE_STANDARD_FALLBACK_MODELS=openai/gpt-5.6-luna,openai/gpt-5.4-mini
KINGXFORD_CREATIVE_DEEP_MODEL=openai/gpt-5.6-sol
KINGXFORD_CREATIVE_DEEP_FALLBACK_MODELS=openai/gpt-5.4,openai/gpt-5.6-terra

# Coordinated project review. These roles share a validated Atlas snapshot and
# return proposals only; they never deploy or mutate projects.
KINGXFORD_INTELLIGENCE_STANDARD_MODEL=openai/gpt-5.6-terra
KINGXFORD_INTELLIGENCE_STANDARD_FALLBACK_MODELS=openai/gpt-5.6-luna,openai/gpt-5.4-mini
KINGXFORD_INTELLIGENCE_DEEP_MODEL=openai/gpt-5.6-sol
KINGXFORD_INTELLIGENCE_DEEP_FALLBACK_MODELS=openai/gpt-5.4,openai/gpt-5.6-terra

# Public-review safeguards. Values may be lowered but are clamped to these
# reviewed ceilings. Upstash applies the same allowance atomically across
# server instances; these counters are operational limits, not billing balances.
KINGXFORD_AGENT_REQUESTS_PER_MINUTE=6
KINGXFORD_AGENT_DAILY_CREDITS=30
KINGXFORD_AGENT_MAX_CONCURRENT=2

# Required in Preview and Production. Set a unique high-entropy server-only
# value of at least 32 characters. It pseudonymizes visitor and account usage
# identifiers; rotation changes those identifiers but never project content.
KINGXFORD_USAGE_HASH_SALT=

# Vercel Workflow requires no application secret. The authenticated durable
# review endpoint becomes ready only when Supabase (including the service role),
# Upstash, AI Gateway identity, and KINGXFORD_USAGE_HASH_SALT are all configured.
# Analytics and Speed Insights also use Vercel-managed configuration.
