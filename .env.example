# Optional: AI SDK Gateway authentication for Kingxford Agent.
# Vercel deployments can use the platform-provided OIDC token instead.
AI_GATEWAY_API_KEY=

# Frontier model and versioned creative-agent protocol.
KINGXFORD_CREATIVE_MODEL=openai/gpt-5.6-sol

# Keep empty until the separate entrepreneurship platform has a real URL.
NEXT_PUBLIC_AI_ENTREPRENEURSHIP_URL=
